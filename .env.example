# =================================================================
# Sutra - The Open Enterprise Operating System
# Environment Configuration
# =================================================================

# Node Environment
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Security & Secret Keys
JWT_SECRET=sutra-enterprise-super-secure-jwt-secret-replace-in-production
JWT_EXPIRATION=7d
ENCRYPTION_KEY=32_characters_random_encryption_key_here_for_aes256

# PostgreSQL Database (with pgvector)
DATABASE_URL=postgresql://sutra_admin:sutra_secure_pass@localhost:5432/sutra_db?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_USER=sutra_admin
DB_PASSWORD=sutra_secure_pass
DB_NAME=sutra_db

# Valkey (Linux Foundation Open Source In-Memory Engine, Task Queue & Cache)
VALKEY_URL=valkey://localhost:6379

# MinIO / S3 Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=sutra_minio_admin
MINIO_SECRET_KEY=sutra_minio_secret_key_123
MINIO_BUCKET_DOCUMENTS=sutra-documents
MINIO_BUCKET_ATTACHMENTS=sutra-attachments

# Jurisdiction & Default Localization
DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=INR
TIMEZONE=Asia/Kolkata
FISCAL_YEAR_START_MONTH=4 # April for India (Apr - Mar)

# India Compliance Settings
INDIA_GST_AUTO_CALCULATE=true
INDIA_GST_EINVOICE_SANDBOX=true
INDIA_TDS_ENABLED=true

# Generative AI Core Settings
# Options for AI_PROVIDER: 'local' (Ollama/vLLM) | 'openai' | 'gemini' | 'anthropic'
AI_PROVIDER=local
AI_MODEL_NAME=llama3.2
AI_LOCAL_ENDPOINT=http://localhost:11434

# Cloud AI API Keys (Optional - only required if AI_PROVIDER is set to cloud)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
